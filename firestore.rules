rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: Any authenticated user can read display names & avatars for collaboration & assignment. Only the user can write their profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Personal isolated tasks (legacy / personal backup)
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared Collaborative Lists
    match /lists/{listId} {
      // Allow read if user is in member list
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );

      // Allow create if user is setting themselves as owner & member
      allow create: if request.auth != null && (
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.memberUids
      );

      // Allow update if user is an existing member or owner
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );

      // Allow delete only by list owner
      allow delete: if request.auth != null && (
        resource.data.ownerId == request.auth.uid
      );

      // Real-time Tasks under the Shared List
      match /tasks/{taskId} {
        // Members of the parent list can read and write tasks in real-time
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids
        );
      }

      // Real-time EOD (End of Day) Reports under the Shared List
      match /eodReports/{reportId} {
        // Any member of the workspace can read team EOD reports
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids
        );

        // Members can create/update their own EOD report or Founder can manage
        allow create, update: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids &&
          (request.resource.data.userId == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/lists/$(listId)).data.ownerId)
        );

        // Owner/Founder or author can delete
        allow delete: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberUids &&
          (resource.data.userId == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/lists/$(listId)).data.ownerId)
        );
      }
    }
  }
}
